{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["scripts/dev-backend.sh", "--port", "8000"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173,
      "autoPort": true,
      "env": { "LEXGRAPH_API_PROXY": "http://127.0.0.1:8000" }
    }
  ]
}
